# Copy this file to .env.local for local testing. On Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.

# Required: your Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: which Claude model to use (default: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Optional: require visitors to enter this code before running anything.
# Useful for a private beta. Leave empty for a fully public page.
# ACCESS_CODE=

# Optional: only accept requests from these origins (comma-separated).
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Optional limits (defaults shown)
# RATE_LIMIT_PER_HOUR=20        # runs per visitor per hour, all tasks
# RESEARCH_LIMIT_PER_HOUR=5     # company research runs per visitor per hour
# DAILY_REQUEST_CAP=300         # runs per day across all visitors

# Recommended for production: shared rate limits across all server instances.
# Create a free Upstash Redis database (Vercel → Storage → Upstash) and paste:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
